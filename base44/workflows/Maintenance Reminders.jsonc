{
  "name": "Maintenance Reminders",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "maintenance_reminders",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "send_reminders": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendMaintenanceNotifications"
          },
          "then": "end",
          "x-base44": {
            "title": "Send maintenance reminders",
            "description": "Daily push notifications"
          }
        }
      }
    ]
  },
  "description": "Sends daily push notifications for upcoming or overdue preventative maintenance, starting one week before the due date, until the owner silences reminders or updates the maintenance date.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 8 * * *",
      "one_time_date": null,
      "timezone": "America/Indiana/Indianapolis",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}