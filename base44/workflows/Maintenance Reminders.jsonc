{
  "name": "Maintenance Reminders",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "maintenance_reminders",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "send_reminders": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendMaintenanceNotifications"
          },
          "then": "end",
          "x-base44": {
            "title": "Send maintenance reminders",
            "description": "Checked hourly; sends at 9am local"
          }
        }
      }
    ]
  },
  "description": "Sends maintenance push notifications around 9am in each owner's local time, once every 24 hours, for upcoming or overdue preventative maintenance. Alerts start one week before the due date and continue until the owner silences reminders or updates the maintenance date. Priority is normal while the due date is ahead and critical on the due day or once overdue.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 * * * *",
      "one_time_date": null,
      "timezone": "America/Indiana/Indianapolis",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}