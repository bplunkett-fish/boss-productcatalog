{
  "name": "Product",
  "type": "object",
  "properties": {
    "model_number": {
      "type": "string",
      "title": "Model Number"
    },
    "product_name": {
      "type": "string",
      "title": "Product Name"
    },
    "product_description": {
      "type": "string",
      "title": "Product Description"
    },
    "category": {
      "type": "string",
      "title": "Category"
    },
    "manufacturer": {
      "type": "string",
      "title": "Manufacturer"
    },
    "image_url": {
      "type": "string",
      "title": "Image URL",
      "format": "uri"
    },
    "service_interval": {
      "type": "string",
      "title": "Service Interval",
      "description": "How often preventative maintenance should be performed (e.g. 'Every 6 months', '500 hours', 'Annually')."
    },
    "manuals": {
      "type": "array",
      "title": "Manuals",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "file_type": {
            "type": "string"
          }
        }
      }
    },
    "literature": {
      "type": "array",
      "title": "Product Literature",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "file_type": {
            "type": "string"
          }
        }
      }
    },
    "wiring_diagrams": {
      "type": "array",
      "title": "Wiring Diagrams",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    },
    "videos": {
      "type": "array",
      "title": "Videos",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "thumbnail": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    },
    "faqs": {
      "type": "array",
      "title": "FAQs",
      "items": {
        "type": "object",
        "properties": {
          "question": {
            "type": "string"
          },
          "answer": {
            "type": "string"
          }
        }
      }
    },
    "troubleshooting": {
      "type": "array",
      "title": "Troubleshooting",
      "items": {
        "type": "object",
        "properties": {
          "problem": {
            "type": "string"
          },
          "solution": {
            "type": "string"
          }
        }
      }
    },
    "parts_links": {
      "type": "array",
      "title": "Parts Store Links",
      "items": {
        "type": "object",
        "properties": {
          "part_number": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    }
  },
  "required": [
    "model_number",
    "product_name"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}