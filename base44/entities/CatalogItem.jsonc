{
  "name": "CatalogItem",
  "type": "object",
  "properties": {
    "serial_number": {
      "type": "string",
      "title": "Serial Number"
    },
    "model_number": {
      "type": "string",
      "title": "Model Number"
    },
    "last_maintenance_date": {
      "type": "string",
      "title": "Last Maintenance Date",
      "format": "date"
    },
    "maintenance_due_date": {
      "type": "string",
      "title": "Maintenance Due Date",
      "format": "date"
    },
    "maintenance_silenced": {
      "type": "boolean",
      "title": "Maintenance Reminders Silenced",
      "default": false
    },
    "last_reminder_sent_at": {
      "type": "string",
      "title": "Last Reminder Sent At",
      "description": "Timestamp of the last maintenance push notification sent for this item, used to enforce a 24-hour minimum gap.",
      "format": "date-time"
    }
  },
  "required": [
    "serial_number",
    "model_number"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}