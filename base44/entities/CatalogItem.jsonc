{
  "name": "CatalogItem",
  "type": "object",
  "properties": {
    "serial_number": {
      "type": "string",
      "title": "Serial Number"
    },
    "model_number": {
      "type": "string",
      "title": "Model Number"
    },
    "product_name": {
      "type": "string",
      "title": "Product Name"
    },
    "product_description": {
      "type": "string",
      "title": "Product Description"
    },
    "category": {
      "type": "string",
      "title": "Category"
    },
    "manufacturer": {
      "type": "string",
      "title": "Manufacturer"
    },
    "image_url": {
      "type": "string",
      "title": "Image URL",
      "format": "uri"
    },
    "manuals": {
      "type": "array",
      "title": "Manuals",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "file_type": {
            "type": "string"
          }
        }
      }
    },
    "wiring_diagrams": {
      "type": "array",
      "title": "Wiring Diagrams",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    },
    "videos": {
      "type": "array",
      "title": "Videos",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "thumbnail": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    },
    "faqs": {
      "type": "array",
      "title": "FAQs",
      "items": {
        "type": "object",
        "properties": {
          "question": {
            "type": "string"
          },
          "answer": {
            "type": "string"
          }
        }
      }
    },
    "troubleshooting": {
      "type": "array",
      "title": "Troubleshooting",
      "items": {
        "type": "object",
        "properties": {
          "problem": {
            "type": "string"
          },
          "solution": {
            "type": "string"
          }
        }
      }
    },
    "parts_links": {
      "type": "array",
      "title": "Parts Store Links",
      "items": {
        "type": "object",
        "properties": {
          "part_number": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "price": {
            "type": "number"
          }
        }
      }
    }
  },
  "required": [
    "serial_number",
    "product_name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}