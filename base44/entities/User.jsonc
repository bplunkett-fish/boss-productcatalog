{
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "is_active": {
      "type": "boolean",
      "title": "Active",
      "description": "Set to false to deactivate the account. A deactivated user keeps their history but loses access to the app until an admin reactivates them.",
      "default": true
    },
    "notification_preferences": {
      "type": "array",
      "title": "Notification Preferences",
      "description": "Notification categories the user has opted into. Unset means the user has never saved a choice, so every category is enabled. Once saved, this list is authoritative: only the listed categories are delivered, and an empty list means all categories are off.",
      "items": {
        "type": "string"
      }
    },
    "first_name": {
      "type": "string",
      "title": "First Name"
    },
    "last_name": {
      "type": "string",
      "title": "Last Name"
    },
    "phone_number": {
      "type": "string",
      "title": "Phone Number"
    },
    "address": {
      "type": "string",
      "title": "Address"
    },
    "profile_picture": {
      "type": "string",
      "title": "Profile Picture",
      "format": "uri"
    },
    "timezone": {
      "type": "string",
      "title": "Timezone",
      "description": "IANA timezone captured from the user's device, used to schedule notifications at the user's local time."
    }
  },
  "required": [
    "role"
  ],
  "name": "User",
  "type": "object"
}