{
  "name": "AppNotification",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "title": "User ID"
    },
    "title": {
      "type": "string",
      "title": "Title"
    },
    "content": {
      "type": "string",
      "title": "Content"
    },
    "category": {
      "type": "string",
      "title": "Category"
    },
    "priority": {
      "type": "string",
      "title": "Priority",
      "enum": [
        "normal",
        "critical"
      ],
      "default": "normal"
    },
    "ref_id": {
      "type": "string",
      "title": "Reference ID"
    },
    "read": {
      "type": "boolean",
      "title": "Read",
      "default": false
    },
    "action_url": {
      "type": "string",
      "title": "Action URL",
      "format": "uri"
    }
  },
  "required": [
    "user_id",
    "title",
    "content"
  ],
  "rls": {
    "read": {
      "data.user_id": "{{user.id}}"
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}