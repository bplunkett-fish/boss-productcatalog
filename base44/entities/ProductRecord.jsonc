{
  "name": "ProductRecord",
  "type": "object",
  "properties": {
    "serial_number": {
      "type": "string",
      "title": "Serial Number"
    },
    "model_number": {
      "type": "string",
      "title": "Model Number"
    },
    "warranty_status": {
      "type": "string",
      "title": "Warranty Status",
      "description": "Warranty state of this specific unit. Set from the CSV import today; refreshed from the ERP once that feed is live.",
      "enum": [
        "Active",
        "Available",
        "Expired",
        "Pending Verification"
      ]
    }
  },
  "required": [
    "serial_number",
    "model_number"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}